  "injection": {
    "enabled": true,
    "detectors": {},
    "disabled": [],
    "maxScanChars": 200000,
    "decodeEncodedPayloads": true,
    "allowlist": []
  },
  "resumeBrief": {
    "enabled": true,
    "sources": [
      ".pi/harness-bridge/active-resume.md"
    ],
    "refreshMode": "static",
    "markerPolicy": "optional"
  },
  "escalation": {
    "noApprover": "fail",
    "note": "An unattended caller cannot answer an escalation, and an unanswered question is not an approval."
  },
  "secrets": {
    "enabled": true,
    "action": "block",
    "allowlist": [
      "EXAMPLE",
      "REDACTED",
      "PLACEHOLDER",
      "your-key-here"
    ],
    "minLength": 20,
    "fixtureGlobs": [
      "**/*.test.ts",
      "**/*.test.js",
      "**/*.spec.ts",
      "**/test/**",
      "**/tests/**",
      "**/__tests__/**",
      "**/fixtures/**",
      "**/testdata/**"
    ],
    "fixtureAction": "warn",
    "fixturePatterns": [
      "*"
    ]
  },
  "capability": {
    "enabled": false,
    "mode": "warn",
    "timeoutMs": 15000
  },
  "commits": {
    "conventional": true,
    "maxSubject": 72,
    "forbidNoVerify": true
  },
  "audit": {
    "path": ".pi/harness-bridge/audit.jsonl",
    "chain": true,
    "recordAllows": false
  }
}