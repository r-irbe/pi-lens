{
	"compilerOptions": {
		"target": "ES2022",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"rootDir": ".",
		"outDir": "./dist",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"lib": ["ES2022"],
		"types": ["node"]
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules", "test-lsp-files", "_trigger-test.ts", "tests", "dist"]
}
