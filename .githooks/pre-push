#!/usr/bin/env sh
# Generated by harness-bridge. Blocks force pushes and protected-branch pushes.
set -e
remote="$1"
url="$2"
branch=$(git rev-parse --abbrev-ref HEAD)
if [ -z "$HARNESS_BRIDGE_CMD" ]; then
  HARNESS_BRIDGE_CMD="npx --no-install harness-bridge"
fi
# The hook cannot see the flags git was given, so it checks the branch and the
# remote. Force pushes are caught by the guard on the bash tool and by the
# critique workflow. Each value is quoted separately: a ref name may legally
# contain a quote or a semicolon, and interpolating one into a shell word would
# let it close the quote.
$HARNESS_BRIDGE_CMD guard command git push "$remote" "$branch" || {
  echo "pre-push: policy blocked this push to $branch" >&2
  exit 1
}
# policy: ci.local.requireBeforePush. A failing local set refuses the push.
if [ -x scripts/ci/local.sh ]; then
  scripts/ci/local.sh --fast || {
    echo "pre-push: local CI set failed; fix it, or run scripts/ci/local.sh to see why" >&2
    exit 1
  }
else
  echo "pre-push: ci.local.requireBeforePush is set but scripts/ci/local.sh is missing" >&2
  echo "pre-push: run: harness-bridge ci generate" >&2
  exit 1
fi
